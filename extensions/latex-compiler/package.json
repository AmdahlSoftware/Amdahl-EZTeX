{
  "name": "latex-compiler",
  "displayName": "LaTeX Compiler",
  "description": "Compile LaTeX files from within EZTeX.",
  "version": "0.0.1",
  "publisher": "amdahl-software",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:latex",
    "onCommand:latex-compiler.compile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "latex-compiler.compile",
        "title": "Compile LaTeX File"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "typescript": "^5.0.0"
  }
}
